data: {"type": "tool_result", "payload": {"name": "search_literature", "result": "[{\"paper_id\": \"W4312051216\", \"标题\": \"ChatGPT: The End of Online Exam Integrity?\", \"年份\": 2022, \"作者\": [\"Teo Sušnjak\"], \"摘要片段\": \"This study evaluated the ability of ChatGPT, a recently developed artificial intelligence (AI) agent, to perform high-level cognitive tasks and produce text that is indistinguishable from human-genera\"}, {\"paper_id\": \"0055f6405e76455fbb221357ee42b5af\", \"标题\": \"It Helps with Crap Lecturers and Their Low Effort : Investigating Computer Science Students’ Perceptions of Using ChatGPT for Learning\", \"年份\": 2024, \"作者\": [\"Mireilla Bikanga Ada\"], \"摘要片段\": \"This study explores how computing science students ( n = 335) use ChatGPT, their trust in its information, their navigation of plagiarism issues, and their confidence in addressing plagiarism and acad\"}, {\"paper_id\": \"70706be38fd2488e8e1cd42563b6ccf4\", \"标题\": \"ChatGPT Assistance in Academic Assignments by Example\", \"年份\": 2023, \"作者\": [\"Sorana D. BOLBOACĂ\"], \"摘要片段\": \"In one Ethics and Academic Integrity discipline assignment, the master's degree students (five students) were asked to choose one scenario (six scenarios were available). Each scenario had a case desc\"}, {\"paper_id\": \"W4360939370\", \"标题\": \"Using ChatGPT and Other Large Language Model (LLM) Applications for Academic Paper Assignments\", \"年份\": 2023, \"作者\": [\"Andreas Jungherr\"], \"摘要片段\": \"Large language models (LLMs), like ChatGPT, GitHub Copilot, and Microsoft Copilot, present challenges in university education, particularly for paper assignments. These AI-driven tools enable students\"}, {\"paper_id\": \"W4388832642\", \"标题\": \"ChatGPT in academic writing: Maximizing its benefits and minimizing the risks\", \"年份\": 2023, \"作者\": [\"Himel Mondal\", \"Shaikat Mondal\"], \"摘要片段\": \"This review article explores the use of ChatGPT in academic writing and provides insights on how to utilize it judiciously. With the increasing popularity of AI-powered language models, ChatGPT has em\"}, {\"提示\": \"另有 1 篇论文与本轮此前结果重复,已省略。\"}]"}, "meta": {"runtime": "langgraph", "node": "execute_tools", "phase": "证据检索", "elapsed_ms": 5637, "session_id": "a04b-insufficient-20260810"}}

