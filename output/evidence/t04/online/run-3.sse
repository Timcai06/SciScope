data: {"type": "tool_result", "payload": {"name": "search_literature", "result": "[{\"paper_id\": \"W4411065983\", \"标题\": \"Retrieval-Augmented Generation and Hallucination in Large Language Models: A Scholarly Overview\", \"年份\": 2025, \"作者\": [\"Sagar Gupta\"], \"摘要片段\": \"Large Language Models (LLMs) have revolutionized natural language processing tasks, yet they often suffer from \\\"hallucination” the confident generation of factually incorrect information. Retrieval-Au\"}, {\"paper_id\": \"W4405272436\", \"标题\": \"ReRag: A New Architecture for Reducing the Hallucination by Retrieval- Augmented Generation\", \"年份\": 2024, \"作者\": [\"Ryeowook Ko\", \"Mustafa Kağan Gürkan\", \"Fatoş T. Yarman Vural\"], \"摘要片段\": \"As the application areas of Generative AI models become widespread, new problems arise. One of these problems is the “hallucination” observed in Large Language Models (LLM). Recently, Retrieval-Augmen\"}, {\"paper_id\": \"W4408145721\", \"标题\": \"Hallucination Mitigation for Retrieval-Augmented Large Language Models: A Review\", \"年份\": 2025, \"作者\": [\"Wan Zhang\", \"Jing Zhang\"], \"摘要片段\": \"Retrieval-augmented generation (RAG) leverages the strengths of information retrieval and generative models to enhance the handling of real-time and domain-specific knowledge. Despite its advantages, \"}, {\"paper_id\": \"2410.15116\", \"标题\": \"Coarse-to-Fine Highlighting: Reducing Knowledge Hallucination in Large Language Models\", \"年份\": 2024, \"作者\": [\"Qitan Lv\", \"Jie Wang\", \"Hanzhu Chen\"], \"摘要片段\": \"Generation of plausible but incorrect factual information, often termed hallucination, has attracted significant research interest. Retrieval-augmented language model (RALM) -- which enhances models w\"}, {\"paper_id\": \"W4415337914\", \"标题\": \"ConfRAG: Confidence-Guided Retrieval-Augmenting Generation\", \"年份\": 2025, \"作者\": [\"Yin Huang\", \"Yifan Ethan Xu\", \"Kai Sun\"], \"摘要片段\": \"Can Large Language Models (LLMs) be trained to avoid hallucinating factual statements, and can Retrieval-Augmented Generation (RAG) be triggered only when necessary to reduce retrieval and computation\"}, {\"paper_id\": \"W4389974671\", \"标题\": \"\\\"Knowing When You Don't Know\\\": A Multilingual Relevance Assessment Dataset for Robust Retrieval-Augmented Generation\", \"年份\": 2023, \"作者\": [\"Nandan Thakur\", \"Luiz Bonifacio\", \"Xinyu ZHANG\"], \"摘要片段\": \"Retrieval-Augmented Generation (RAG) grounds Large Language Model (LLM) output by leveraging external knowledge sources to reduce factual hallucinations. However, prior work lacks a comprehensive eval\"}]"}, "meta": {"runtime": "langgraph", "node": "execute_tools", "phase": "证据检索", "elapsed_ms": 3945, "session_id": "t04-20260812T134352Z-run-3"}}

data: {"type": "tool_result", "payload": {"name": "summarize_field", "result": "{\"主题\": \"retrieval-augmented generation hallucination reduction\", \"素材论文\": [{\"标题\": \"Attention Mapping for Hallucination Reduction in Arabic Financial Using Retrieval-Augmented Generation Systems\", \"年份\": 2025, \"摘要片段\": \"This research introduces a customized attention visualization framework for mitigating hallucinations in Arabic Retrieval-Augmented Generation (RAG) systems tai\"}, {\"标题\": \"FVA-RAG: Falsification-Verification Alignment for Mitigating Sycophantic Hallucinations\", \"年份\": 2025, \"摘要片段\": \"Retrieval-Augmented Generation (RAG) reduces hallucinations by grounding answers in retrieved evidence, yet standard retrievers often exhibit retrieval sycophan\"}, {\"标题\": \"Removal of Hallucination on Hallucination: Debate-Augmented RAG\", \"年份\": 2025, \"摘要片段\": \"Retrieval-Augmented Generation (RAG) enhances factual accuracy by integrating external knowledge, yet it introduces a critical issue: erroneous or biased retrie\"}, {\"标题\": \"Hallucination Mitigation for Retrieval-Augmented Large Language Models: A Review\", \"年份\": 2025, \"摘要片段\": \"Retrieval-augmented generation (RAG) leverages the strengths of information retrieval and generative models to enhance the handling of real-time and domain-spec\"}, {\"标题\": \"Hallucination Reduction in Large Language Models with Retrieval-Augmented Generation Using Wikipedia Knowledge\", \"年份\": 2024, \"摘要片段\": \"Natural language understanding and generation have seen great progress, yet the persistent issue of hallucination undermines the reliability of model outputs. I\"}, {\"标题\": \"ReRag: A New Architecture for Reducing the Hallucination by Retrieval- Augmented Generation\", \"年份\": 2024, \"摘要片段\": \"As the application areas of Generative AI models become widespread, new problems arise. One of these problems is the “hallucination” observed in Large Language \"}, {\"标题\": \"MultiRAG: A Knowledge-Guided Framework for Mitigating Hallucination in Multi-Source Retrieval Augmented Generation\", \"年份\": 2025, \"摘要片段\": \"Retrieval Augmented Generation (RAG) has emerged as a promising solution to address hallucination issues in Large Language Models (LLMs). However, the integrati\"}, {\"标题\": \"Retrieval-Augmented Generation and Hallucination in Large Language Models: A Scholarly Overview\", \"年份\": 2025, \"摘要片段\": \"Large Language Models (LLMs) have revolutionized natural language processing tasks, yet they often suffer from \\\"hallucination” the confident generation of factu\"}, {\"标题\": \"A retrieval augmented generation based optimization approach for medical knowledge understanding and reasoning in large language models\", \"年份\": 2025, \"摘要片段\": \"Based on the existing Retrieval Augmented Generation (RAG) technology, this study proposes innovative solution to better address the hallucination issues of cur\"}, {\"标题\": \"Reducing hallucination in structured outputs via Retrieval-Augmented Generation\", \"年份\": 2024, \"摘要片段\": \"A common and fundamental limitation of Generative AI (GenAI) is its propensity to hallucinate. While large language models (LLM) have taken the world by storm, \"}], \"提示\": \"请据此综述研究现状,引用标题\"}"}, "meta": {"runtime": "langgraph", "node": "execute_tools", "phase": "证据检索", "elapsed_ms": 3945, "session_id": "t04-20260812T134352Z-run-3"}}

