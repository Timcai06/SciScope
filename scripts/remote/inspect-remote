#!/usr/bin/env bash
set +e

SCISCOPE_ROOT="${SCISCOPE_ROOT:-/home/liu/workspaces/sciscope}"
SCISCOPE_REPO="${SCISCOPE_REPO:-${SCISCOPE_ROOT}/repo}"
CONDA_ROOT="${CONDA_ROOT:-/home/liu/miniconda3}"
export PATH="${HOME}/.local/bin:${PATH}"

section() {
  printf '\n=== %s ===\n' "$1"
}

show_command() {
  local command_name="$1"
  if command -v "${command_name}" >/dev/null 2>&1; then
    printf '%-12s %s\n' "${command_name}" "$(command -v "${command_name}")"
  else
    printf '%-12s %s\n' "${command_name}" MISSING
  fi
}

section SYSTEM
printf 'host=%s\n' "$(hostname)"
printf 'kernel=%s\n' "$(uname -srmo)"
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  source /etc/os-release
  printf 'os=%s\n' "${PRETTY_NAME:-unknown}"
fi
printf 'cpu_threads=%s\n' "$(nproc)"
lscpu | grep -E 'Model name|Socket|Core|Thread|CPU max MHz' || true
free -h
df -h / "${SCISCOPE_ROOT}" 2>/dev/null | awk 'NR == 1 || !seen[$1]++'

section GPU
nvidia-smi --query-gpu=name,driver_version,memory.total,memory.used,temperature.gpu,power.limit \
  --format=csv,noheader || true

section CLI
for command_name in \
  git git-lfs tmux rg fd fzf bat tree aria2c htop nvtop ncdu psql \
  docker rtk shellcheck; do
  show_command "${command_name}"
done

section DOCKER
id
docker version --format 'client={{.Client.Version}} server={{.Server.Version}}' 2>&1
docker compose version 2>&1
printf 'service=%s\n' "$(systemctl is-active docker 2>/dev/null)"
docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' 2>&1

section REPOSITORY
if [[ -d "${SCISCOPE_REPO}/.git" ]]; then
  git -C "${SCISCOPE_REPO}" status --short
  printf 'branch=%s\n' "$(git -C "${SCISCOPE_REPO}" branch --show-current)"
  printf 'commit=%s\n' "$(git -C "${SCISCOPE_REPO}" rev-parse HEAD)"
  git -C "${SCISCOPE_REPO}" log -1 --oneline
else
  echo 'repository=MISSING'
fi

section CONDA_AND_PYTORCH
if [[ -r "${CONDA_ROOT}/etc/profile.d/conda.sh" ]]; then
  # shellcheck disable=SC1091
  source "${CONDA_ROOT}/etc/profile.d/conda.sh"
  conda env list
  if conda run -n sciscope python -V >/dev/null 2>&1; then
    conda run -n sciscope python -V
    conda run -n sciscope python -c \
      'import torch; print(f"torch={torch.__version__}"); print(f"cuda_available={torch.cuda.is_available()}"); print(f"cuda_runtime={torch.version.cuda}"); print(f"cuda_device={torch.cuda.get_device_name(0) if torch.cuda.is_available() else None}")'
    conda run -n sciscope python -c \
      'import fastapi, langgraph, mcp, pgvector, psycopg, sentence_transformers; print("backend_imports=ok")'
  else
    echo 'sciscope_env=MISSING'
  fi
else
  echo 'conda=MISSING'
fi

section STORAGE_LAYOUT
for path in data models artifacts logs runtime backups; do
  if [[ -e "${SCISCOPE_ROOT}/${path}" ]]; then
    du -sh "${SCISCOPE_ROOT}/${path}" 2>/dev/null
  else
    printf '%s=MISSING\n' "${path}"
  fi
done

section ENTRY_POINT
show_command tim
show_command tim-bash
show_command tim-doctor
[[ -x "${HOME}/.local/bin/tim" ]] && echo 'entry=ok' || echo 'entry=MISSING'
[[ -r "${HOME}/.config/tim/zsh/.zshrc" ]] && echo 'zsh_config=ok' || echo 'zsh_config=MISSING'
[[ -r "${HOME}/.config/tim/tim.bash" ]] && echo 'bash_config=ok' || echo 'bash_config=MISSING'
