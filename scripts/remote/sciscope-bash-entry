#!/usr/bin/env bash
set -Eeuo pipefail

SESSION="tim-bash"
INIT_FILE="${HOME}/.config/tim/tim.bash"

if [[ ! -r "${INIT_FILE}" ]]; then
  echo "Missing ${INIT_FILE}; rerun scripts/setup_remote_compute.sh." >&2
  exit 1
fi

if tmux has-session -t "=${SESSION}" 2>/dev/null; then
  exec tmux attach-session -t "=${SESSION}"
fi

exec tmux new-session -s "${SESSION}" -c "${PWD}" \
  "bash --rcfile ${INIT_FILE} -i"
